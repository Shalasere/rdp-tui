#!/usr/bin/env sh
# Run the editable project installation so its declared dependencies are used.
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
launcher="$project_dir/.venv/bin/rdp-tui"

if [ ! -x "$launcher" ]; then
  echo "rdp-tui is not set up yet. Run: make setup" >&2
  exit 1
fi

exec "$launcher" "$@"
